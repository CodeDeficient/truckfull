import { RADIUS_OPTIONS_GUEST, RADIUS_OPTIONS_AUTHENTICATED } from '@/lib/filters/types';

describe('Radius Options', () => {
  test('RADIUS_OPTIONS_GUEST should equal [5, 10, 15, 25]', () => {
    expect(RADIUS_OPTIONS_GUEST).toEqual([5, 10, 15, 25]);
  });

  test('RADIUS_OPTIONS_AUTHENTICATED should equal [5, 10, 25, 50, 100, 200, 500, 800]', () => {
    expect(RADIUS_OPTIONS_AUTHENTICATED).toEqual([5, 10, 25, 50, 100, 200, 500, 800]);
  });
});