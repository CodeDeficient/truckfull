{
  // Production deployment requires a human-prepared .container-build.env with
  // production public values only; staging or local values prohibit deployment.
  //
  // vars contains non-secret, provider-public deployment values only
  // (the project rules "Deployment Configuration Exception"). Private credentials are
  // Cloudflare secrets and never appear in this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truckfull-container-production",
  "main": "worker/container.mjs",
  "build": {
    "command": "node scripts/container/validate-production-public-build-env.mjs && node scripts/deploy/validate-reliability-safeguards.mjs",
  },
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "truckfull.food", "custom_domain": true },
    { "pattern": "www.truckfull.food", "custom_domain": true },
  ],
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedStaticAssets": { "type": "worker", "cache": { "enabled": true } },
  },
  "observability": {
    "enabled": true,
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "APP_ENV": "production",
    "STATIC_ASSET_CACHE_ENABLED": "true",
    "EDGE_PAGE_CACHE": "on",
    "COLUMBUS_TIMELY_API_KEY": "your-columbus-timely-api-key",
    "ENABLE_AUTO_APPROVAL": "true",
    "FOURSQUARE_ENABLED": "false",
    "MACON_ALGOLIA_API_KEY": "your-macon-algolia-api-key",
    "MACON_ALGOLIA_APP_ID": "your-macon-algolia-app-id",
    "SAVANNAH_EPROVAL_CALENDAR_KEY": "your-savannah-eproval-calendar-key",
    "NEXT_CACHE_R2": "on",
    "NEXT_PUBLIC_APP_URL": "https://www.truckfull.food",
    "NEXT_PUBLIC_BILLING_ENABLED": "true",
    "NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN": "pk.your-mapbox-public-token",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_your-posthog-project-key",
    "NEXT_PUBLIC_SUPABASE_URL": "https://exampleprodref000000.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_your-supabase-key",
    "NODE_ENV": "production",
    "TURNSTILE_ALLOWED_HOSTNAMES": "www.truckfull.food,truckfull.food",
  },
  "containers": [
    {
      "class_name": "TruckFullContainer",
      "image": "./Dockerfile.container",
      "instance_type": "basic",
      "max_instances": 1,
      "name": "truckfull-production",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TruckFullContainer",
        "name": "TRUCKFULL_CONTAINER",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "NEXT_CACHE_BUCKET",
      "bucket_name": "example-next-cache-production",
    },
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["TruckFullContainer"],
      "tag": "v1",
    },
  ],
  "triggers": {
    "crons": [],
  },
}
