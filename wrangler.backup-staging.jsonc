{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truckfull-backup-staging",
  "main": "worker/backup.mjs",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "BACKUP_ENABLED": "true",
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "example-backups-staging",
    },
  ],
  "containers": [
    {
      "class_name": "BackupContainer",
      "image": "./containers/backup/Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 1,
      "name": "truckfull-backup-staging",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BackupContainer",
        "name": "BACKUP_CONTAINER",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["BackupContainer"],
      "tag": "v1",
    },
  ],
  "triggers": {
    "crons": ["0 1 * * SUN"],
  },
}
