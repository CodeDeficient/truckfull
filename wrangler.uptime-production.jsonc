{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truckfull-uptime-production",
  "main": "worker/uptime.mjs",
  "build": {
    "command": "node scripts/deploy/validate-reliability-safeguards.mjs",
  },
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "MONITOR_URLS": "https://www.truckfull.food/api/health",
    "PAGE_MONITOR_URLS": "https://www.truckfull.food/,https://www.truckfull.food/trucks",
    "ALERT_EMAIL_FROM": "TruckFull Uptime <noreply@truckfull.food>",
    "CF_ACCOUNT_ID": "your-cloudflare-account-id",
  },
  "kv_namespaces": [
    {
      "binding": "UPTIME_STATE",
      "id": "your-kv-namespace-id",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
}
