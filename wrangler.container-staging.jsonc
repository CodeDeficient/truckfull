{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truckfull-container-staging",
  "main": "worker/container.mjs",
  "build": {
    "command": "node scripts/container/validate-staging-public-build-env.mjs",
  },
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "staging.example.com", "custom_domain": true },
  ],
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedStaticAssets": { "type": "worker", "cache": { "enabled": true } },
  },
  "vars": {
    "APP_ENV": "staging",
    "NEXT_CACHE_R2": "on",
    "STATIC_ASSET_CACHE_ENABLED": "true",
    "EDGE_PAGE_CACHE": "on",
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "containers": [
    {
      "class_name": "TruckFullContainer",
      "image": "./Dockerfile.container-staging",
      "instance_type": "basic",
      "max_instances": 1,
      "name": "truckfull-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TruckFullContainer",
        "name": "TRUCKFULL_CONTAINER"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "NEXT_CACHE_BUCKET",
      "bucket_name": "example-next-cache-staging"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["TruckFullContainer"],
      "tag": "v1"
    }
  ],
  "triggers": {
    "crons": []
  },
}
