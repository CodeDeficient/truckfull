# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://<projectid>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_PASSWORD=""

# Firebase Cloud Messaging (for push notifications)
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Get VAPID key from Firebase Console > Project Settings > Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Firebase Admin SDK (for server-side push notifications)
# Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=""

# API Keys
GEMINI_API_KEY=""
TAVILY_API_KEY=""

# Exa AI Search (for high-profile event research)
# Get from: https://exa.ai
# Set RESEARCH_DISABLE_EXA=1 to skip Exa (e.g., when out of credits)
EXA_API_KEY=""

# Brave Search API (for event research fallback)
# Get from: https://brave.com/search/api/
# Free tier: 1,000 requests/month
BRAVE_API_KEY=""

# Scira AI Research (for deep event research)
# Get from: https://scira.ai
SCRIA_API_KEY=""
SCRIA_API_URL="https://api.scira.ai/v1"

# Cron job authentication secret
CRON_SECRET=""

# Edge credential for the event revalidation endpoint (X-TruckFull-Internal header).
# Must be set on the deployed app or /api/revalidate/event returns 500.
TRUCKFULL_EDGE_SECRET=""

# Stripe (for subscription payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_RESTRICTED_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs (get these from Stripe Dashboard after creating products)
NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_STARTER_FOUNDING=""
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_PRO_FOUNDING=""
# App URL (for Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Explicit production app URL for production-only maintenance scripts.
PROD_APP_URL=""

# Optional: Database direct connection (for advanced use cases)
# DATABASE_URL=

# Optional: Gemini model configuration
# GEMINI_MODEL=gemini-pro
# GEMINI_MAX_TOKENS=32000
# GEMINI_DAILY_REQUEST_LIMIT=1500

# TomTom Traffic API (for real-time traffic data)
# Get from: https://developer.tomtom.com/traffic-api
# Free tier: 2,500 requests/day
TOMTOM_API_KEY=

# Foursquare Places API (for venue popularity and foot traffic)
# Get from: https://foursquare.com/developers/
# Free tier: ~100,000 calls/month
FOURSQUARE_API_KEY=

# =============================================================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# =============================================================================

# Eventbrite API (for event ingestion pipeline)
# Get from: https://www.eventbrite.com/platform/
# EVENTBRITE_PRIVATE_TOKEN=
# EVENTBRITE_PUBLIC_TOKEN=
# EVENTBRITE_API_KEY=
# EVENTBRITE_WINDOW_BUDGET=2000    # Max API calls per rate limit window
# EVENTBRITE_SAFETY_BUFFER=100     # Headroom subtracted from window budget
# EVENTBRITE_WINDOW_MS=1223000    # Rate limit window duration (~20 min)
# EVENTBRITE_KEYWORD_SKIP_THRESHOLD=200  # Skip keyword search when existingIds exceeds this
# EVENTBRITE_MAX_PAGES=20         # Max pagination pages per city

# Mapbox (maps and the optional traffic heatmap tileset)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_TRAFFIC_TILESET_URL=
NEXT_PUBLIC_TRAFFIC_SOURCE_LAYER=

# City event feeds (public keys published by each city's calendar)
COLUMBUS_TIMELY_API_KEY=
MACON_ALGOLIA_APP_ID=
MACON_ALGOLIA_API_KEY=
SAVANNAH_EPROVAL_CALENDAR_KEY=

# IndexNow verification key
INDEXNOW_KEY=

# Comma-separated truck slugs whose photos fill the /trucks hub showcase
HUB_SHOWCASE_SLUGS=

# Google Maps (for map integration)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Yelp API (for additional data sources)
# YELP_API_KEY=
# YELP_CLIENT_ID=

# Facebook Graph API (for Facebook page data)
# Get these from: https://developers.facebook.com/apps
FACEBOOK_APP_ID="<your_facebook_app_id>"
FACEBOOK_APP_SECRET="<your_facebook_app_secret>"

# Facebook Page Access Token (for Graph API backfill)
# Get from: https://developers.facebook.com/tools/explorer/
# After app is in production mode, generate permanent token with these permissions:
# - pages_show_list
# - pages_read_user_content
# - pages_read_engagement
FACEBOOK_PAGE_ACCESS_TOKEN="<your_facebook_page_access_token>"

# Meta Webhooks (for Facebook page real-time updates)
# META_WEBHOOK_VERIFY_TOKEN=<random-string-min-32-chars>
# META_WEBHOOK_APP_SECRET=<from-meta-developer-console>
# Get these from: https://developers.facebook.com/apps

# =============================================================================
# SCHEDULING CONFIGURATION
# =============================================================================

# Cron-like schedule for data quality checks
SCHEDULE_DATA_QUALITY_CHECK="0 0 */12 * *" # Every 12 hours
SCHEDULE_LOCATION_UPDATES="*/30 * * * *"   # Every 30 minutes

# Enable/disable scheduled tasks
ENABLE_DATA_QUALITY_MONITORING=true
ENABLE_REAL_TIME_UPDATES=true

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Log levels: error, warn, info, debug
LOG_LEVEL=info

# Sentry (error tracking) - optional
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# SLACK_WEBHOOK_URL=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret for API authentication (generate a strong random string)
JWT_SECRET=""

# Upstash Redis (for rate limiting)
# REQUIRED for /api/auth/* routes: the proxy fails closed (503) for the whole
# /api/auth/ prefix when these are unset, so email signup (and the signup
# rate limit) will not work without them.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# API rate limiting (legacy - now using Upstash)
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=development

# Next.js configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000
# Branding
SITE_NAME=TruckFull
NEXT_PUBLIC_SITE_NAME=TruckFull

# Debug flags
DEBUG_DATABASE=false

# Mock data (for development/testing)
USE_MOCK_DATA=false
MOCK_DELAY=1000

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Uncomment and configure these for production deployment

# Domain and SSL
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com
# FORCE_HTTPS=true

# Performance optimization
# ENABLE_CACHING=true
# CACHE_TTL=3600  # 1 hour

# Database connection pooling
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# CDN configuration (for images/assets)
# CDN_URL=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
FEATURE_AI_PROCESSING=true
FEATURE_GEOSPATIAL_QUERIES=true
FEATURE_REAL_TIME_NOTIFICATIONS=false
FEATURE_USER_REVIEWS=false
FEATURE_TRUCK_OWNER_DASHBOARD=false

# Legacy (pre-Meta-webhook) post processing pipeline. Defaults to disabled;
# set to true ONLY for temporary diagnostic use. Leave false in Production.
ENABLE_LEGACY_POST_PROCESSING=false

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Database backup configuration
# BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30
# BACKUP_STORAGE_URL=

# Maintenance windows
# MAINTENANCE_WINDOW_START=02:00
# MAINTENANCE_WINDOW_END=04:00
# MAINTENANCE_TIMEZONE=UTC

# OpenRouter API key for AI fallback (get from openrouter.ai)
OPENROUTER_API_KEY=

# SearXNG (self-hosted metasearch for event research)
SEARXNG_URL=http://localhost:8888
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# =============================================================================
# CLOUDFLARE TURNSTILE (signup bot protection)
# =============================================================================

# Server-side secret key (from Cloudflare Turnstile dashboard)
TURNSTILE_SECRET_KEY=
# Client-side site key (public, embedded in the widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Comma-separated hostname allowlist verified against the siteverify response.
# Production: absent/empty = configuration failure -> signup fails closed (503).
# Staging/preview/local allowances must be explicit (e.g. "example.com,localhost").
TURNSTILE_ALLOWED_HOSTNAMES=

# =============================================================================
# SIGNUP RATE LIMIT (per IP, Upstash Redis)
# =============================================================================

# Max signup attempts per IP per window
SIGNUP_RATE_LIMIT_MAX=10
# Window in Upstash Duration format (ms|s|m|h|d)
SIGNUP_RATE_LIMIT_WINDOW=15m

# =============================================================================
# LOCAL SUPABASE (autoconfirm E2E)
# =============================================================================

# Injected at runtime by scripts/run-autoconfirm-e2e.cjs
# from `npx supabase status -o json`.
# Optional manual overrides for running the autoconfirm spec directly:
# LOCAL_SUPABASE_URL=http://127.0.0.1:54321
# LOCAL_SUPABASE_ANON_KEY=
