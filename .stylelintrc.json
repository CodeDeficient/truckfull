{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-standard-scss",
    "stylelint-config-tailwindcss"
  ],
  "plugins": ["stylelint-order"],
  "rules": {
    "indentation": 2,
    "string-quotes": "single",
    "no-duplicate-selectors": true,
    "color-named": "never",
    "color-hex-case": "lower",
    "color-hex-length": "short",
    "function-url-quotes": "always",
    "value-no-vendor-prefix": true,
    "property-no-vendor-prefix": true,
    "declaration-block-no-duplicate-properties": true,
    "selector-max-id": 0,
    "selector-class-pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "responsive",
          "screen",
          "layer",
          "use",
          "forward",
          "mixin",
          "include",
          "if",
          "else",
          "each",
          "for",
          "while",
          "each",
          "debug",
          "warn",
          "error",
          "content",
          "function",
          "return"
        ]
      }
    ],
    "order/order": [
      [
        "dollar-variables",
        "custom-properties",
        "at-rules",
        "declarations",
        {
          "type": "at-rule",
          "name": "supports"
        },
        {
          "type": "at-rule",
          "name": "media"
        },
        "rules"
      ]
    ],
    "order/properties-order": [
      [
        "content",
        "position",
        "top",
        "right",
        "bottom",
        "left",
        "z-index",
        "display",
        "vertical-align",
        "flex",
        "flex-grow",
        "flex-shrink",
        "flex-basis",
        "flex-direction",
        "flex-wrap",
        "flex-flow",
        "justify-content",
        "align-items",
        "align-self",
        "align-content",
        "order",
        "grid",
        "grid-area",
        "grid-template",
        "grid-template-areas",
        "grid-template-rows",
        "grid-template-columns",
        "grid-row",
        "grid-row-start",
        "grid-row-end",
        "grid-column",
        "grid-column-start",
        "grid-column-end",
        "grid-auto-rows",
        "grid-auto-columns",
        "grid-auto-flow",
        "gap",
        "row-gap",
        "column-gap",
        "margin",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left",
        "margin-block",
        "margin-block-start",
        "margin-block-end",
        "margin-inline",
        "margin-inline-start",
        "margin-inline-end",
        "padding",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left",
        "padding-block",
        "padding-block-start",
        "padding-block-end",
        "padding-inline",
        "padding-inline-start",
        "padding-inline-end",
        "float",
        "clear",
        "object-fit",
        "object-position",
        "overflow",
        "overflow-x",
        "overflow-y",
        "overflow-block",
        "overflow-inline",
        "overflow-wrap",
        "word-wrap",
        "word-break",
        "word-spacing",
        "letter-spacing",
        "white-space",
        "text-align",
        "text-align-last",
        "text-transform",
        "text-decoration",
        "text-emphasis",
        "text-emphasis-color",
        "text-emphasis-style",
        "text-emphasis-position",
        "text-indent",
        "text-justify",
        "text-wrap",
        "text-overflow",
        "text-orientation",
        "text-shadow",
        "text-rendering",
        "text-size-adjust",
        "text-combine-upright",
        "text-orientation",
        "text-underline-position",
        "font",
