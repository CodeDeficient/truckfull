import { describe, it, expect, beforeAll, afterAll } from '@jest/globals';
import { createClient, SupabaseClient } from '@supabase/supabase-js';

/*
 * PostGIS Extension Compatibility Integration Tests
 *
 * Purpose: Verify PostGIS extension works correctly after migration from `public` to `extensions` schema
 *
 * Context: PostGIS functions must be accessible via search_path = public, extensions
 * This test suite verifies:
 * 1. PostGIS functions (ST_Distance, ST_DWithin, ST_MakePoint, ST_SetSRID) are callable
 * 2. Geography type columns work in food_trucks, hotspots, traffic_nodes tables
 * 3. RPC functions using PostGIS return correct results
 * 4. No "function does not exist" or "type does not exist" errors
 *
 * Important: These tests require a real database with PostGIS properly configured.
 * Do NOT run against production database - use local or staging environment.
 *
 * Database Requirements:
 * - PostGIS extension enabled (in extensions or public schema)
 * - RPC functions with SET search_path = public, extensions
 * - Tables with location_geog columns
 * - Spatial data in tables (for meaningful test results)
 */

describe('PostGIS Extension Compatibility Tests', () => {
  let adminClient: SupabaseClient;
  let testFoodTruckId: string | null = null;
  let testHotspotId: string | null = null;
  let testTrafficNodeId: string | null = null;

  const TEST_LAT = 33.749;
  const TEST_LNG = -84.388;
  const TEST_RADIUS_METERS = 1000;

  beforeAll(() => {
    const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
    const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

    if (!supabaseUrl || !serviceRoleKey) {
      throw new Error(
        'Missing required environment variables: NEXT_PUBLIC_SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY',
      );
    }

    adminClient = createClient(supabaseUrl, serviceRoleKey);
  });

  afterAll(async () => {
    if (testFoodTruckId) {
      await adminClient.from('food_trucks').delete().eq('id', testFoodTruckId);
    }
    if (testHotspotId) {
      await adminClient.from('hotspots').delete().eq('id', testHotspotId);
    }
    if (testTrafficNodeId) {
      await adminClient.from('traffic_nodes').delete().eq('id', testTrafficNodeId);
    }
  });

  describe('PostGIS Function Availability', () => {
    it('ST_Distance function is callable from RPC', async () => {
      const { data, error } = await adminClient.rpc('get_location_traffic_score', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: TEST_RADIUS_METERS,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });

    it('ST_DWithin function is callable from RPC', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: TEST_RADIUS_METERS,
        p_limit: 10,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });

    it('ST_SetSRID function is callable from RPC', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_hotspot', {
        lat: TEST_LAT,
        lng: TEST_LNG,
        radius_meters: TEST_RADIUS_METERS,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });

    it('ST_MakePoint function is callable from RPC', async () => {
      const { data, error } = await adminClient.rpc('find_trucks_within_radius', {
        user_lat: TEST_LAT,
        user_lng: TEST_LNG,
        radius_meters: TEST_RADIUS_METERS,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });
  });

  describe('Geography Type Support', () => {
    describe('food_trucks table', () => {
      it('insert record with geography column succeeds', async () => {
        const { data, error } = await adminClient
          .from('food_trucks')
          .insert({
            name: `Test Truck ${Date.now()}`,
            description: 'PostGIS integration test truck',
            current_location: { lat: TEST_LAT, lng: TEST_LNG },
            cuisine_type: ['test'],
            contact_info: {},
            operating_hours: {},
            menu_items: {},
            social_media: {},
            is_active: true,
          })
          .select('id, location_geog')
          .single();

        expect(error).toBeNull();
        if (!data) {
          throw new Error('No data returned from insert');
        }
        expect(data.id).toBeTruthy();
        testFoodTruckId = data.id;
      });

      it('query geography column returns string representation', async () => {
        if (!testFoodTruckId) return;

        const { data, error } = await adminClient
          .from('food_trucks')
          .select('location_geog')
          .eq('id', testFoodTruckId)
          .single();

        expect(error).toBeNull();
        if (!data) {
          throw new Error('No data returned from query');
        }
        expect(data.location_geog).toBeTruthy();
        expect(typeof data.location_geog).toBe('string');
      });

      it('geography type is not null when location provided', async () => {
        if (!testFoodTruckId) return;

        const { data, error } = await adminClient
          .from('food_trucks')
          .select('location_geog')
          .eq('id', testFoodTruckId)
          .single();

        expect(error).toBeNull();
        if (!data) {
          throw new Error('No data returned from query');
        }
        expect(data.location_geog).not.toBeNull();
      });
    });

    describe('hotspots table', () => {
      it('insert record with geography column succeeds', async () => {
        const { data, error } = await adminClient
          .from('hotspots')
          .insert({
            lat: TEST_LAT + 0.001,
            lng: TEST_LNG + 0.001,
            is_active: true,
          })
          .select('id, location_geog')
          .single();

        expect(error).toBeNull();
        if (!data) {
          throw new Error('No data returned from insert');
        }
        expect(data.id).toBeTruthy();
        testHotspotId = data.id;
      });

      it('query geography column returns string representation', async () => {
        if (!testHotspotId) return;

        const { data, error } = await adminClient
          .from('hotspots')
          .select('location_geog')
          .eq('id', testHotspotId)
          .single();

        expect(error).toBeNull();
        if (!data) {
          throw new Error('No data returned from query');
        }
        expect(data.location_geog).toBeTruthy();
        expect(typeof data.location_geog).toBe('string');
      });
    });

    describe('traffic_nodes table', () => {
      it('insert record with geography column succeeds', async () => {
        const { data, error } = await adminClient
          .from('traffic_nodes')
          .insert({
            state_code: 'GA',
            station_id: `TEST_${Date.now()}`,
            aadt: 1000,
            location_geog: `0101000020E6100000${(TEST_LNG + 0.002).toString().padStart(24, '0')}${(TEST_LAT + 0.002).toString().padStart(24, '0')}`,
            lat: TEST_LAT + 0.002,
            lng: TEST_LNG + 0.002,
            score_percentile: 50,
          })
          .select('id, location_geog')
          .single();

        expect(error).toBeNull();
        if (!data) {
          throw new Error('No data returned from insert');
        }
        expect(data.id).toBeTruthy();
        testTrafficNodeId = data.id;
      });

      it('query geography column returns string representation', async () => {
        if (!testTrafficNodeId) return;

        const { data, error } = await adminClient
          .from('traffic_nodes')
          .select('location_geog')
          .eq('id', testTrafficNodeId)
          .single();

        expect(error).toBeNull();
        if (!data) {
          throw new Error('No data returned from query');
        }
        expect(data.location_geog).toBeTruthy();
        expect(typeof data.location_geog).toBe('string');
      });
    });
  });

  describe('RPC Function Integration', () => {
    describe('find_nearby_traffic_nodes', () => {
      it('uses ST_Distance and returns distance_meters', async () => {
        const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
          p_lat: TEST_LAT,
          p_lng: TEST_LNG,
          p_radius_meters: TEST_RADIUS_METERS,
          p_limit: 10,
        });

        expect(error).toBeNull();
        expect(data).toBeTruthy();
        expect(Array.isArray(data)).toBeTruthy();

        if (data.length > 0) {
          expect(data[0]).toHaveProperty('distance_meters');
          expect(typeof data[0].distance_meters).toBe('number');
          expect(data[0].distance_meters).toBeGreaterThanOrEqual(0);
        }
      });

      it('uses ST_DWithin for radius filtering', async () => {
        const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
          p_lat: TEST_LAT,
          p_lng: TEST_LNG,
          p_radius_meters: 100,
          p_limit: 50,
        });

        expect(error).toBeNull();
        expect(data).toBeTruthy();
        expect(Array.isArray(data)).toBeTruthy();

        if (data.length > 0) {
          data.forEach((node: any) => {
            expect(node.distance_meters).toBeLessThanOrEqual(100);
          });
        }
      });
    });

    describe('get_location_traffic_score', () => {
      it('uses ST_DWithin for area filtering', async () => {
        const { data, error } = await adminClient.rpc('get_location_traffic_score', {
          p_lat: TEST_LAT,
          p_lng: TEST_LNG,
          p_radius_meters: TEST_RADIUS_METERS,
        });

        expect(error).toBeNull();
        expect(data).toBeTruthy();
        expect(Array.isArray(data)).toBeTruthy();

        if (data.length > 0) {
          expect(data[0]).toHaveProperty('station_count');
          expect(typeof data[0].station_count).toBe('number');
          expect(data[0].station_count).toBeGreaterThanOrEqual(0);
        }
      });
    });

    describe('find_nearby_hotspot', () => {
      it('uses ST_Distance and ST_DWithin', async () => {
        const { data, error } = await adminClient.rpc('find_nearby_hotspot', {
          lat: TEST_LAT,
          lng: TEST_LNG,
          radius_meters: TEST_RADIUS_METERS,
        });

        expect(error).toBeNull();
        expect(data).toBeTruthy();
        expect(Array.isArray(data)).toBeTruthy();

        if (data.length > 0) {
          expect(data[0]).toHaveProperty('distance_meters');
          expect(typeof data[0].distance_meters).toBe('number');
          expect(data[0].distance_meters).toBeGreaterThanOrEqual(0);
          expect(data[0].distance_meters).toBeLessThanOrEqual(TEST_RADIUS_METERS);
        }
      });
    });
  });

  describe('Search Path Compatibility', () => {
    it('functions work regardless of PostGIS schema location', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: TEST_RADIUS_METERS,
        p_limit: 1,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
    });

    it('no "function does not exist" errors for ST_Distance', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_hotspot', {
        lat: TEST_LAT,
        lng: TEST_LNG,
        radius_meters: TEST_RADIUS_METERS,
      });

      expect(error).toBeNull();
      if (error) {
        expect(error.message).not.toContain('does not exist');
      }
      expect(data).toBeTruthy();
    });

    it('no "type does not exist" errors for geography', async () => {
      const { data, error } = await adminClient
        .from('food_trucks')
        .select('location_geog')
        .limit(1);

      expect(error).toBeNull();
      if (error) {
        expect(error.message).not.toContain('does not exist');
      }
      expect(data).toBeTruthy();
    });

    it('functions work after schema changes', async () => {
      const functions = [
        adminClient.rpc('find_nearby_traffic_nodes', {
          p_lat: TEST_LAT,
          p_lng: TEST_LNG,
          p_radius_meters: TEST_RADIUS_METERS,
          p_limit: 1,
        }),
        adminClient.rpc('get_location_traffic_score', {
          p_lat: TEST_LAT,
          p_lng: TEST_LNG,
          p_radius_meters: TEST_RADIUS_METERS,
        }),
        adminClient.rpc('find_nearby_hotspot', {
          lat: TEST_LAT,
          lng: TEST_LNG,
          radius_meters: TEST_RADIUS_METERS,
        }),
      ];

      const results = await Promise.all(functions);

      results.forEach(({ data, error }) => {
        expect(error).toBeNull();
        expect(data).toBeTruthy();
      });
    });
  });

  describe('Geometry Calculations', () => {
    it('ST_Distance returns positive meters', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: TEST_RADIUS_METERS,
        p_limit: 10,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();

      if (data.length > 0) {
        data.forEach((node: any) => {
          expect(node.distance_meters).toBeGreaterThan(0);
        });
      }
    });

    it('ST_Distance returns reasonable distances', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: 100000,
        p_limit: 10,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();

      if (data.length > 0) {
        data.forEach((node: any) => {
          expect(node.distance_meters).toBeGreaterThan(0);
          expect(node.distance_meters).toBeLessThan(100000);
        });
      }
    });

    it('ST_DWithin correctly filters by radius', async () => {
      const radius = 500;
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: radius,
        p_limit: 50,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();

      if (data.length > 0) {
        data.forEach((node: any) => {
          expect(node.distance_meters).toBeLessThanOrEqual(radius);
        });
      }
    });

    it('ST_MakePoint creates valid geography from lat/lng', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_hotspot', {
        lat: 33.749,
        lng: -84.388,
        radius_meters: TEST_RADIUS_METERS,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
    });

    it('ST_SetSRID sets correct SRID (4326 = WGS84)', async () => {
      const { data, error } = await adminClient.rpc('get_location_traffic_score', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: TEST_RADIUS_METERS,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });
  });

  describe('Tables with Geography Columns', () => {
    it('food_trucks.location_geog works correctly', async () => {
      const { data, error } = await adminClient
        .from('food_trucks')
        .select('id, name, location_geog')
        .not('location_geog', 'is', null)
        .limit(5);

      expect(error).toBeNull();
      if (!data) {
        throw new Error('No data returned from query');
      }
      expect(Array.isArray(data)).toBeTruthy();

      if (data.length > 0) {
        data.forEach((truck: any) => {
          expect(truck.location_geog).toBeTruthy();
          expect(typeof truck.location_geog).toBe('string');
        });
      }
    });

    it('hotspots.location_geog works correctly', async () => {
      const { data, error } = await adminClient
        .from('hotspots')
        .select('id, lat, lng, location_geog')
        .limit(5);

      expect(error).toBeNull();
      if (!data) {
        throw new Error('No data returned from query');
      }
      expect(Array.isArray(data)).toBeTruthy();

      if (data.length > 0) {
        data.forEach((hotspot: any) => {
          expect(hotspot.location_geog).toBeTruthy();
          expect(typeof hotspot.location_geog).toBe('string');
        });
      }
    });

    it('traffic_nodes.location_geog works correctly', async () => {
      const { data, error } = await adminClient
        .from('traffic_nodes')
        .select('id, lat, lng, location_geog')
        .limit(5);

      expect(error).toBeNull();
      if (!data) {
        throw new Error('No data returned from query');
      }
      expect(Array.isArray(data)).toBeTruthy();

      if (data.length > 0) {
        data.forEach((node: any) => {
          expect(node.location_geog).toBeTruthy();
          expect(typeof node.location_geog).toBe('string');
        });
      }
    });

    it('all three tables support PostGIS operations', async () => {
      const [trucksResult, hotspotsResult, nodesResult] = await Promise.all([
        adminClient.from('food_trucks').select('id').limit(1),
        adminClient.from('hotspots').select('id').limit(1),
        adminClient.from('traffic_nodes').select('id').limit(1),
      ]);

      expect(trucksResult.error).toBeNull();
      expect(hotspotsResult.error).toBeNull();
      expect(nodesResult.error).toBeNull();

      expect(trucksResult.data).toBeTruthy();
      expect(hotspotsResult.data).toBeTruthy();
      expect(nodesResult.data).toBeTruthy();
    });
  });

  describe('Error Handling', () => {
    it('handles null coordinates gracefully', async () => {
      const { data, error } = await adminClient
        .from('food_trucks')
        .insert({
          name: `Test Truck No Location ${Date.now()}`,
          description: 'Test truck without location',
          cuisine_type: ['test'],
          contact_info: {},
          operating_hours: {},
          menu_items: {},
          social_media: {},
          is_active: true,
        })
        .select('id, location_geog')
        .single();

      expect(error).toBeNull();
      if (!data) {
        throw new Error('No data returned from insert');
      }
      expect(data.location_geog).toBeNull();

      if (data.id) {
        await adminClient.from('food_trucks').delete().eq('id', data.id);
      }
    });

    it('provides helpful error messages for invalid coordinates', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: 999,
        p_lng: 999,
        p_radius_meters: TEST_RADIUS_METERS,
        p_limit: 10,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });

    it('handles zero radius gracefully', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: 0,
        p_limit: 10,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });

    it('handles large radius values', async () => {
      const { data, error } = await adminClient.rpc('find_nearby_traffic_nodes', {
        p_lat: TEST_LAT,
        p_lng: TEST_LNG,
        p_radius_meters: 1000000,
        p_limit: 10,
      });

      expect(error).toBeNull();
      expect(data).toBeTruthy();
      expect(Array.isArray(data)).toBeTruthy();
    });
  });
});
