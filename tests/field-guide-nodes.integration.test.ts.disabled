      // This test would require mocking the database to fail
      // In a real integration test, you might temporarily break the DB connection
      // For now, we'll skip this test or make it optional
      console.warn('Database error test requires DB mocking, skipping');
    });

    it('returns 500 on RPC function error', async () => {
      // This test would require mocking the RPC function to fail
      // In a real integration test, you might use invalid RPC parameters
      // For now, we'll skip this test or make it optional
      console.warn('RPC error test requires function mocking, skipping');
    });

    it('returns 400 with details for invalid parameters', async () => {
      const response = await fetch(
        `http://localhost:3000/api/field-guide/nodes?lat=invalid&lng=${VALID_LNG}&radius=5000&limit=10`,
      );

      expect(response.status).toBe(400);
      const body = await response.json();
      expect(body.error).toBe('Invalid parameters');
      expect(body.details).toBeDefined();
      expect(Array.isArray(body.details)).toBe(true);
    });

    it('error response includes meaningful error message', async () => {
      const response = await fetch(
        `http://localhost:3000/api/field-guide/nodes?lat=invalid&lng=${VALID_LNG}&radius=5000&limit=10`,
      );

      const body = await response.json();
      expect(body.error).toBeDefined();
      expect(typeof body.error).toBe('string');
      expect(body.error.length).toBeGreaterThan(0);
    });

    it('error response includes JSON content-type', async () => {
      const response = await fetch(
        `http://localhost:3000/api/field-guide/nodes?lat=invalid&lng=${VALID_LNG}&radius=5000&limit=10`,
      );

      expect(response.headers.get('content-type')).toContain('application/json');
    });
  });

  describe('Integration Scenarios', () => {
    it('complete workflow: valid request returns correct data structure', async () => {
      if (!testStarterUserId) {
        console.warn('No starter tier test user found, skipping test');
        return;
      }

      const response = await fetch(
        `http://localhost:3000/api/field-guide/nodes?lat=${VALID_LAT}&lng=${VALID_LNG}&radius=5000&limit=20`,
        {
          headers: {
            'x-test-user-id': testStarterUserId,
          },
        },
      );

      expect(response.status).toBe(200);

      const body = await response.json();

      // Verify complete response structure
      expect(body).toHaveProperty('tier');
      expect(body).toHaveProperty('area_stats');
      expect(body).toHaveProperty('nodes');
      expect(body).toHaveProperty('count');
      expect(body).toHaveProperty('query');

      // Verify data types
      expect(typeof body.tier).toBe('string');
      expect(typeof body.count).toBe('number');
      expect(Array.isArray(body.nodes)).toBe(true);
      expect(typeof body.query).toBe('object');

      // Verify logical conditions
      expect(body.count).toBe(body.nodes.length);
      expect(body.query.limit).toBeLessThanOrEqual(20); // Starter tier limit

      // Verify cache headers
      const cacheControl = response.headers.get('cache-control');
      expect(cacheControl).toContain('max-age=3600');
    });

    it('different tiers get different node limits for same query', async () => {
      if (!testStarterUserId || !testProUserId || !testEnterpriseUserId) {
        console.warn('Insufficient test users found, skipping test');
        return;
      }

      // Same query for all tiers
      const queryString = `lat=${VALID_LAT}&lng=${VALID_LNG}&radius=5000&limit=100`;

      // Starter tier request
      const starterResponse = await fetch(
        `http://localhost:3000/api/field-guide/nodes?${queryString}`,
        {
          headers: {
            'x-test-user-id': testStarterUserId,
          },
        },
      );
      const starterBody = await starterResponse.json();

      // Pro tier request
      const proResponse = await fetch(
        `http://localhost:3000/api/field-guide/nodes?${queryString}`,
        {
          headers: {
            'x-test-user-id': testProUserId,
          },
        },
      );
      const proBody = await proResponse.json();

      // Enterprise tier request
      const enterpriseResponse = await fetch(
        `http://localhost:3000/api/field-guide/nodes?${queryString}`,
        {
          headers: {
            'x-test-user-id': testEnterpriseUserId,
          },
        },
      );
      const enterpriseBody = await enterpriseResponse.json();

      // Verify tier limits
      expect(starterBody.count).toBeLessThanOrEqual(20);
      expect(proBody.count).toBeLessThanOrEqual(100);
      expect(enterpriseBody.count).toBeLessThanOrEqual(40000);

      // Verify tier fields are correct
      expect(starterBody.tier).toBe('starter');
      expect(proBody.tier).toBe('pro');
      expect(enterpriseBody.tier).toBe('enterprise');
    });

    it('area_stats are consistent across multiple requests for same location', async () => {
      if (!testStarterUserId) {
        console.warn('No starter tier test user found, skipping test');
        return;
      }

      const queryString = `lat=${VALID_LAT}&lng=${VALID_LNG}&radius=5000&limit=10`;

      const response1 = await fetch(`http://localhost:3000/api/field-guide/nodes?${queryString}`, {
        headers: {
          'x-test-user-id': testStarterUserId,
        },
      });
      const body1 = await response1.json();

      const response2 = await fetch(`http://localhost:3000/api/field-guide/nodes?${queryString}`, {
        headers: {
          'x-test-user-id': testStarterUserId,
        },
      });
      const body2 = await response2.json();

      // area_stats should be the same for the same location
      if (body1.area_stats !== null && body2.area_stats !== null) {
        expect(body1.area_stats.station_count).toBe(body2.area_stats.station_count);
        expect(body1.area_stats.avg_aadt).toBe(body2.area_stats.avg_aadt);
        expect(body1.area_stats.max_aadt).toBe(body2.area_stats.max_aadt);
        expect(body1.area_stats.percentile_score).toBe(body2.area_stats.percentile_score);
        expect(body1.area_stats.traffic_level).toBe(body2.area_stats.traffic_level);
      }
    });

    it('query parameters are correctly passed to backend', async () => {
      if (!testStarterUserId) {
        console.warn('No starter tier test user found, skipping test');
        return;
      }

      const lat = VALID_LAT;
      const lng = VALID_LNG;
      const radius = 7500;
      const limit = 25;

      const response = await fetch(
        `http://localhost:3000/api/field-guide/nodes?lat=${lat}&lng=${lng}&radius=${radius}&limit=${limit}`,
        {
          headers: {
            'x-test-user-id': testStarterUserId,
          },
        },
      );

      const body = await response.json();

      // Verify query parameters are echoed correctly
      expect(body.query.lat).toBe(Number(lat));
      expect(body.query.lng).toBe(Number(lng));
      expect(body.query.radius).toBe(radius);
      expect(body.query.limit).toBeLessThanOrEqual(limit); // May be capped by tier
    });
  });
});
