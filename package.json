    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --quiet",
    "lint:strict": "eslint . --config eslint.config.strict.mjs --quiet",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.{css,scss,ts,tsx,js,jsx}\" --fix",
    "lint:css:check": "stylelint \"**/*.{css,scss,ts,tsx,js,jsx}\"",
    "format": "prettier --write . --ignore-unknown",
    "test":"cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "playwright test tests/e2e.test.ts",
