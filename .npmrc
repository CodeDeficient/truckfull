ignore-scripts=true

# Block known compromised/denylisted package scopes
# @tanstack — supply-chain attack 2026-05-12 (issue #595)
#   See: https://github.com/TanStack/router/issues/7383
# Redirects @tanstack/* to a non-responsive address so installs fail.
# For unscoped packages (axios), denial is enforced via package.json overrides
# and the security:denylist script.
@tanstack:registry=https://0.0.0.0/
